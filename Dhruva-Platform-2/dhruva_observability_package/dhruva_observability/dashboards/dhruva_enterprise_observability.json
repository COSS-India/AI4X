{
  "id": null,
  "uid": "dhruva-enterprise-ob        {
          "expr": "rate(dhruva_enterprise_requests_total{status_code!~\"2..\", endpoint!~\"/metrics.*|/enterprise/metrics.*|/health.*|/enterprise/health.*\"}[5m]) / rate(dhruva_enterprise_requests_total{endpoint!~\"/metrics.*|/enterprise/metrics.*|/health.*|/enterprise/health.*\"}[5m]) * 100",
          "legendFormat": "{{customer}}/{{app}}"
        }ability-v2",
  "title": "Dhruva Enterprise Observability",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["dhruva", "enterprise", "observability"],
  "style": "dark",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "rate(dhruva_enterprise_requests_total{endpoint!~\"/metrics.*|/enterprise/metrics.*|/health.*|/enterprise/health.*\"}[5m])",
          "legendFormat": "{{customer}}/{{app}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "req/s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Response Time (95th Percentile)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(dhruva_enterprise_request_duration_seconds_bucket[5m]))",
          "legendFormat": "95th percentile"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "rate(dhruva_enterprise_requests_total{status_code!~\"2..\", endpoint!~\"/metrics.*|/enterprise/metrics.*|/health.*|/enterprise/health.*\"}[5m]) / rate(dhruva_enterprise_requests_total{endpoint!~\"/metrics.*|/enterprise/metrics.*|/health.*|/enterprise/health.*\"}[5m]) * 100",
          "legendFormat": "{{customer}}/{{app}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "System CPU Usage",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_system_cpu_percent",
          "legendFormat": "CPU Usage"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Service Usage by Customer",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (customer) (rate(dhruva_enterprise_service_requests_total[1h]))",
          "legendFormat": "{{customer}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "title": "Request Duration Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(dhruva_enterprise_request_duration_seconds_bucket[5m]))",
          "legendFormat": "95th percentile"
        },
        {
          "expr": "histogram_quantile(0.50, rate(dhruva_enterprise_request_duration_seconds_bucket[5m]))",
          "legendFormat": "50th percentile"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },
    {
      "id": 7,
      "title": "Request Volume by Endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "rate(dhruva_enterprise_requests_total{endpoint!~\"/metrics.*|/enterprise/metrics.*|/health.*|/enterprise/health.*\"}[1h])",
          "legendFormat": "{{endpoint}} - {{method}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 }
    },
    {
      "id": 8,
      "title": "Resource Utilization",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_system_cpu_percent",
          "legendFormat": "CPU Usage"
        },
        {
          "expr": "dhruva_enterprise_system_memory_percent",
          "legendFormat": "Memory Usage"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 }
    },
    {
      "id": 9,
      "title": "SLA Compliance",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_sla_availability_percent",
          "legendFormat": "Availability - {{customer}}/{{app}}"
        },
        {
          "expr": "dhruva_enterprise_sla_response_time_seconds",
          "legendFormat": "Response Time - {{customer}}/{{app}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 }
    },
    {
      "id": 10,
      "title": "Service Requests by Type",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "rate(dhruva_enterprise_service_requests_total[5m])",
          "legendFormat": "{{service_type}} - {{customer}}/{{app}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 }
    },
    {
      "id": 11,
      "title": "Total API Count by Service",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (service_type) (dhruva_enterprise_service_requests_total)",
          "legendFormat": "{{service_type}}"
        }
      ],
      "fieldConfig": { 
        "defaults": { 
          "unit": "short",
          "color": { "mode": "palette-classic" }
        } 
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 }
    },
    {
      "id": 12,
      "title": "Total API Count by Customer",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (customer) (dhruva_enterprise_requests_total{endpoint!~\"/metrics.*|/enterprise/metrics.*|/health.*|/enterprise/health.*\"})",
          "legendFormat": "{{customer}}"
        }
      ],
      "fieldConfig": { 
        "defaults": { 
          "unit": "short",
          "color": { "mode": "palette-classic" }
        } 
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 }
    }
  ]
}
