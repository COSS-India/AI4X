{
  "id": null,
  "uid": "dhruva-devops-operational-dashboard",
  "title": "Dhruva DevOps Operations Dashboard",
  "description": "Comprehensive operational metrics for DevOps teams monitoring system health, performance, and reliability",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["dhruva", "devops", "operations", "monitoring"],
  "style": "dark",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "customer",
        "type": "query",
        "query": "label_values(dhruva_enterprise_requests_total, customer)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "app",
        "type": "query",
        "query": "label_values(dhruva_enterprise_requests_total{customer=~\"$customer\"}, app)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "🚨 System Health Overview",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "System CPU Usage",
      "description": "Real-time CPU utilization across the platform. High CPU indicates resource contention and potential performance bottlenecks.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_system_cpu_percent",
          "legendFormat": "CPU Usage %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "title": "Memory Utilization",
      "description": "System memory usage monitoring. Critical for preventing OOM issues and ensuring stable service operation.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_system_memory_percent",
          "legendFormat": "Memory Usage %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 }
    },
    {
      "id": 4,
      "title": "Active Services Count",
      "description": "Number of running services in the platform. Monitors service availability and deployment status.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_system_service_count",
          "legendFormat": "Active Services"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 }
    },
    {
      "id": 5,
      "title": "Peak Throughput",
      "description": "Maximum requests per minute the system can handle. Critical for capacity planning and scaling decisions.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_system_peak_throughput_rpm",
          "legendFormat": "Peak RPM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 }
    },
    {
      "id": 6,
      "title": "⚡ Performance Monitoring",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 7,
      "title": "Request Rate by Service",
      "description": "Real-time request rate breakdown by service. Helps identify high-traffic services and load distribution patterns.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (app)(rate(dhruva_enterprise_requests_total{customer=~\"$customer\", app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "pointSize": 5
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 8,
      "title": "Response Time Distribution",
      "description": "Service response time across different endpoints. Critical for SLA compliance and user experience optimization.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (endpoint, le)(rate(dhruva_enterprise_request_duration_seconds_bucket{customer=~\"$customer\", app=~\"$app\"}[5m])))",
          "legendFormat": "95th percentile - {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (endpoint, le)(rate(dhruva_enterprise_request_duration_seconds_bucket{customer=~\"$customer\", app=~\"$app\"}[5m])))",
          "legendFormat": "50th percentile - {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 }
    },
    {
      "id": 9,
      "title": "🔥 Error Analysis",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "id": 10,
      "title": "Error Rate by Service",
      "description": "Error rate monitoring by service endpoint. Essential for identifying problematic services and maintaining SLA compliance.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (endpoint)(rate(dhruva_enterprise_errors_total{customer=~\"$customer\", app=~\"$app\"}[5m]))",
          "legendFormat": "Error Rate - {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "errps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 }
    },
    {
      "id": 11,
      "title": "Error Distribution by Type",
      "description": "Breakdown of errors by HTTP status code. Helps categorize issues as client errors (4xx) vs server errors (5xx).",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (status_code)(increase(dhruva_enterprise_errors_total{customer=~\"$customer\", app=~\"$app\"}[1h]))",
          "legendFormat": "HTTP {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "vis": false }
          }
        }
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 }
    },
    {
      "id": 12,
      "title": "📊 SLA Compliance Monitoring",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }
    },
    {
      "id": 13,
      "title": "Service Availability by Customer",
      "description": "Availability percentage per customer. Critical for maintaining SLA agreements and customer satisfaction.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "avg by (customer)(dhruva_enterprise_sla_availability_percent{customer=~\"$customer\"})",
          "legendFormat": "{{customer}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 95 },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 }
    },
    {
      "id": 14,
      "title": "SLA Compliance Trends",
      "description": "Historical SLA compliance tracking. Monitors adherence to service level agreements over time.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "avg by (sla_type)(dhruva_enterprise_sla_compliance_percent{customer=~\"$customer\", app=~\"$app\"})",
          "legendFormat": "{{sla_type}} Compliance"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 }
    },
    {
      "id": 15,
      "title": "🔧 Resource Utilization Details",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "id": 16,
      "title": "Component Latency Analysis",
      "description": "Latency breakdown by system components. Identifies bottlenecks in the request processing pipeline.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (component, le)(rate(dhruva_enterprise_component_latency_seconds_bucket{customer=~\"$customer\", app=~\"$app\"}[5m])))",
          "legendFormat": "{{component}} - 95th percentile"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 }
    },
    {
      "id": 17,
      "title": "Data Processing Volume",
      "description": "Volume of data processed by type. Monitors system throughput and processing capacity utilization.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (data_type)(rate(dhruva_enterprise_data_processed_total{customer=~\"$customer\", app=~\"$app\"}[5m]))",
          "legendFormat": "{{data_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 }
    },
    {
      "id": 18,
      "title": "🎯 Operational Alerts Dashboard",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 }
    },
    {
      "id": 19,
      "title": "Critical System Metrics Summary",
      "description": "Consolidated view of critical system health indicators for rapid assessment and incident response.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_system_cpu_percent",
          "legendFormat": "CPU Usage (%)",
          "refId": "A"
        },
        {
          "expr": "dhruva_enterprise_system_memory_percent",
          "legendFormat": "Memory Usage (%)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(dhruva_enterprise_requests_total[5m])) * 60",
          "legendFormat": "Request Rate (RPM)",
          "refId": "C"
        },
        {
          "expr": "sum(rate(dhruva_enterprise_errors_total[5m])) * 60",
          "legendFormat": "Error Rate (EPM)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "color-background",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU Usage (%)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 70 },
                    { "color": "red", "value": 90 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory Usage (%)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 80 },
                    { "color": "red", "value": 95 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 46 }
    }
  ]
}
