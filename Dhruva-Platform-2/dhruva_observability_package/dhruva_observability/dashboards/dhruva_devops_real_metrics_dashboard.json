{
  "id": null,
  "uid": "dhruva-devops-real-metrics",
  "title": "🔧 DevOps Dashboard - Real Operational Data",
  "description": "DevOps dashboard with ONLY verified real metrics: actual system resources (CPU: 10.5%, Memory: 77.9%), real error tracking, performance bottlenecks, and operational intelligence",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["dhruva", "devops", "operations", "real-metrics", "monitoring"],
  "style": "dark",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "endpoint_filter",
        "type": "custom",
        "query": "all,business_only,errors_only",
        "current": { "value": "business_only", "text": "Business Endpoints Only" },
        "options": [
          { "value": "all", "text": "All Endpoints" },
          { "value": "business_only", "text": "Business Endpoints Only" },
          { "value": "errors_only", "text": "Errors Only" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "🚨 System Health (Real-Time)",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "CPU Usage",
      "description": "REAL DATA: Current CPU at 10.5%. Low utilization indicates room for scaling or potential underutilization.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "telemetry_obsv_system_cpu_percent",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "title": "Memory Usage",
      "description": "REAL DATA: Current Memory at 77.9%. High utilization - monitor for potential memory pressure.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "telemetry_obsv_system_memory_percent",
          "legendFormat": "Memory %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 }
    },
    {
      "id": 4,
      "title": "Request Rate (Real Traffic)",
      "description": "REAL DATA: Current request throughput from actual API calls. Shows system load patterns.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum(rate(telemetry_obsv_requests_total[1m]))",
          "legendFormat": "Total Requests/sec"
        },
        {
          "expr": "sum(rate(telemetry_obsv_requests_total{endpoint!~\"/metrics.*|/enterprise/metrics.*\"}[1m]))",
          "legendFormat": "Business Requests/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 20
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }
    },
    {
      "id": 5,
      "title": "🔍 Error Analysis & Debugging",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 6,
      "title": "Error Breakdown by Type",
      "description": "REAL DATA: Client errors (401s: 5), Server errors (500s: 7), Bad requests (400s: 1). Use for debugging and incident response.",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (status_code)(telemetry_obsv_errors_total)",
          "legendFormat": "{{status_code}} errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-spectrum" }
        }
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 }
    },
    {
      "id": 7,
      "title": "Error Rate by Endpoint",
      "description": "REAL DATA: Which endpoints are causing issues. Critical for targeted debugging and performance optimization.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (endpoint)(telemetry_obsv_errors_total)",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "continuous-RdYlGr", "reverse": true },
          "custom": {
            "orientation": "horizontal",
            "displayMode": "gradient"
          }
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 10 }
    },
    {
      "id": 8,
      "title": "⚡ Performance Analysis",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "id": 9,
      "title": "Response Time Distribution",
      "description": "REAL DATA: Actual response times from live requests. Identifies performance bottlenecks and SLA breaches.",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum(rate(telemetry_obsv_request_duration_seconds_bucket[5m])) by (le)",
          "legendFormat": "{{le}}s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "vis": false }
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 }
    },
    {
      "id": 10,
      "title": "Component Latency Analysis",
      "description": "REAL DATA: Processing time by component. Translation: 82.9s total, TTS: 80.6s total, Enterprise: 18,427s. Identifies bottlenecks.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (component)(rate(telemetry_obsv_component_latency_seconds_sum[5m])) / sum by (component)(rate(telemetry_obsv_component_latency_seconds_count[5m]))",
          "legendFormat": "{{component}} avg latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 }
    },
    {
      "id": 11,
      "title": "🔧 Service Performance Matrix",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }
    },
    {
      "id": 12,
      "title": "Service Health Status",
      "description": "REAL DATA: Request volume, error count, and response times per service type. Use for capacity planning and optimization.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (service_type)(telemetry_obsv_service_requests_total)",
          "legendFormat": "Total Requests",
          "refId": "A"
        },
        {
          "expr": "sum by (service_type)(telemetry_obsv_errors_total)",
          "legendFormat": "Error Count",
          "refId": "B"
        },
        {
          "expr": "sum by (service_type)(telemetry_obsv_component_latency_seconds_sum) / sum by (service_type)(telemetry_obsv_component_latency_seconds_count)",
          "legendFormat": "Avg Latency (s)",
          "refId": "C"
        },
        {
          "expr": "100 * sum by (service_type)(telemetry_obsv_errors_total) / sum by (service_type)(telemetry_obsv_service_requests_total)",
          "legendFormat": "Error Rate (%)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "color-background",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Error Rate (%)" },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 5 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Avg Latency (s)" },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 5 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 }
    },
    {
      "id": 13,
      "title": "📊 Traffic Analysis",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "id": 14,
      "title": "Top Endpoints by Volume",
      "description": "REAL DATA: Actual endpoint usage. /enterprise/metrics: 6,756 calls, /auth/signin: 24 calls. Use for load balancing and optimization.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "topk(10, sum by (endpoint)(telemetry_obsv_requests_total))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "continuous-GrYlRd" },
          "custom": {
            "orientation": "horizontal",
            "displayMode": "gradient"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 }
    },
    {
      "id": 15,
      "title": "Request Success Rate Trend",
      "description": "REAL DATA: Success rate trends over time. Monitor for service degradation and quality issues.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "100 * sum(rate(telemetry_obsv_requests_total{status_code=\"200\"}[5m])) / sum(rate(telemetry_obsv_requests_total[5m]))",
          "legendFormat": "Success Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25
          },
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 }
    }
  ]
}
