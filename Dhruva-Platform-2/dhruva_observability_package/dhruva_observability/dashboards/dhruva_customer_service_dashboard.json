{
  "id": null,
  "uid": "dhruva-customer-service-dashboard",
  "title": "Dhruva Customer Service Dashboard",
  "description": "Customer-focused dashboard showing service performance, usage analytics, and quality metrics from customer perspective",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["dhruva", "customer", "service", "quality"],
  "style": "light",
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "customer",
        "type": "query",
        "query": "label_values(dhruva_enterprise_requests_total, customer)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": { "value": "default", "text": "Select Customer" }
      },
      {
        "name": "service_type",
        "type": "custom",
        "query": "ASR,TTS,NMT,LLM,All",
        "current": { "value": "All", "text": "All Services" },
        "options": [
          { "value": "All", "text": "All Services" },
          { "value": "ASR", "text": "Speech Recognition" },
          { "value": "TTS", "text": "Text to Speech" },
          { "value": "NMT", "text": "Translation" },
          { "value": "LLM", "text": "Language Models" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "🎯 Your Service Experience",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Service Reliability Score",
      "description": "Your overall service success rate. This represents the percentage of your requests that completed successfully without errors.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "100 * sum(increase(dhruva_enterprise_requests_total{customer=\"$customer\", status_code=\"200\"}[24h])) / sum(increase(dhruva_enterprise_requests_total{customer=\"$customer\"}[24h]))",
          "legendFormat": "Success Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 95 },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.5 }
            ]
          },
          "custom": {
            "displayMode": "gradient",
            "orientation": "horizontal"
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "title": "Average Response Time",
      "description": "How quickly our services respond to your requests. Lower values mean faster service delivery for your applications.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "avg(dhruva_enterprise_sla_response_time_seconds{customer=\"$customer\"})",
          "legendFormat": "Response Time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "custom": {
            "displayMode": "gradient",
            "orientation": "horizontal"
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 }
    },
    {
      "id": 4,
      "title": "Service Availability",
      "description": "Platform uptime dedicated to your services. Our commitment to keeping your applications running 24/7.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "avg(dhruva_enterprise_sla_availability_percent{customer=\"$customer\"})",
          "legendFormat": "Availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 99,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 99 },
              { "color": "yellow", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "custom": {
            "displayMode": "gradient",
            "orientation": "horizontal"
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 }
    },
    {
      "id": 5,
      "title": "📊 Your Usage Analytics",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 6,
      "title": "Daily API Usage Trend",
      "description": "Your daily API request pattern. Track how your application usage varies throughout the day to optimize your integration.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum(rate(dhruva_enterprise_requests_total{customer=\"$customer\", status_code=\"200\"}[1h])) * 3600",
          "legendFormat": "Successful Requests/Hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "pointSize": 4
          },
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 7,
      "title": "Service Usage Breakdown",
      "description": "How you're using different AI services. This helps understand which services provide the most value to your business.",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (app)(increase(dhruva_enterprise_requests_total{customer=\"$customer\", status_code=\"200\"}[24h]))",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "vis": false }
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["percent"]
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 }
    },
    {
      "id": 8,
      "title": "🚀 Service Performance Insights",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "id": 9,
      "title": "Response Time by Service",
      "description": "Performance comparison across different AI services you're using. Helps identify which services perform best for your needs.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "avg by (app)(dhruva_enterprise_sla_response_time_seconds{customer=\"$customer\"})",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "continuous-GrYlRd" },
          "custom": {
            "orientation": "horizontal",
            "displayMode": "gradient"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 }
    },
    {
      "id": 10,
      "title": "Service Quality Trend",
      "description": "Success rate trends for your most used services. Monitor service quality consistency over time.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "100 * sum by (app)(rate(dhruva_enterprise_requests_total{customer=\"$customer\", status_code=\"200\"}[1h])) / sum by (app)(rate(dhruva_enterprise_requests_total{customer=\"$customer\"}[1h]))",
          "legendFormat": "{{app}} Success Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 3
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 }
    },
    {
      "id": 11,
      "title": "💡 Your AI Processing Insights",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }
    },
    {
      "id": 12,
      "title": "LLM Token Usage",
      "description": "Tokens processed through language models. Monitor your AI text processing volume and understand your application's AI processing patterns.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum(increase(dhruva_enterprise_llm_tokens_processed_total{customer=\"$customer\"}[24h]))",
          "legendFormat": "Tokens Processed (24h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 }
    },
    {
      "id": 13,
      "title": "TTS Characters Generated",
      "description": "Characters converted to speech. Track your text-to-speech usage volume for voice application insights.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum(increase(dhruva_enterprise_tts_characters_synthesized_total{customer=\"$customer\"}[24h]))",
          "legendFormat": "Characters (24h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 28 }
    },
    {
      "id": 14,
      "title": "Translation Characters",
      "description": "Characters translated between languages. Monitor your multilingual application usage and expansion opportunities.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum(increase(dhruva_enterprise_nmt_characters_translated_total{customer=\"$customer\"}[24h]))",
          "legendFormat": "Characters Translated (24h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 28 }
    },
    {
      "id": 15,
      "title": "Total Data Processed",
      "description": "Overall data volume processed across all AI services. Comprehensive view of your platform utilization.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum(increase(dhruva_enterprise_data_processed_total{customer=\"$customer\"}[24h]))",
          "legendFormat": "Data Units Processed (24h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 28 }
    },
    {
      "id": 16,
      "title": "📈 Your Usage Patterns",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "id": 17,
      "title": "Processing Volume by AI Service",
      "description": "Data processing volume breakdown by AI service type. Understand which AI capabilities you utilize most.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (data_type)(rate(dhruva_enterprise_data_processed_total{customer=\"$customer\"}[1h]))",
          "legendFormat": "{{data_type}} processing rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15,
            "stackingMode": "normal"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 }
    },
    {
      "id": 18,
      "title": "Monthly Usage Quotas",
      "description": "Your monthly service quotas and current usage. Plan your application scaling and usage optimization.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "dhruva_enterprise_customer_llm_quota_per_month{customer=\"$customer\"}",
          "legendFormat": "LLM Quota"
        },
        {
          "expr": "dhruva_enterprise_customer_tts_quota_per_month{customer=\"$customer\"}",
          "legendFormat": "TTS Quota"
        },
        {
          "expr": "dhruva_enterprise_customer_nmt_quota_per_month{customer=\"$customer\"}",
          "legendFormat": "Translation Quota"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "continuous-GrYlRd" },
          "custom": {
            "orientation": "horizontal",
            "displayMode": "gradient"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 }
    },
    {
      "id": 19,
      "title": "🎯 Service Quality Summary",
      "type": "row",
      "collapsed": false,
      "datasource": null,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 }
    },
    {
      "id": 20,
      "title": "Your Service Performance Report",
      "description": "Comprehensive performance summary for your applications. Use this data for technical discussions and service optimization.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "kdjfS_R7c" },
      "targets": [
        {
          "expr": "sum by (app)(increase(dhruva_enterprise_requests_total{customer=\"$customer\", status_code=\"200\"}[24h]))",
          "legendFormat": "Successful Requests (24h)",
          "refId": "A"
        },
        {
          "expr": "100 * sum by (app)(increase(dhruva_enterprise_requests_total{customer=\"$customer\", status_code=\"200\"}[24h])) / sum by (app)(increase(dhruva_enterprise_requests_total{customer=\"$customer\"}[24h]))",
          "legendFormat": "Success Rate (%)",
          "refId": "B"
        },
        {
          "expr": "avg by (app)(dhruva_enterprise_sla_response_time_seconds{customer=\"$customer\"})",
          "legendFormat": "Avg Response Time (s)",
          "refId": "C"
        },
        {
          "expr": "avg by (app)(dhruva_enterprise_sla_availability_percent{customer=\"$customer\"})",
          "legendFormat": "Availability (%)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "color-background",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Success Rate (%)" },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "color": "red", "value": 95 },
                    { "color": "yellow", "value": 99 },
                    { "color": "green", "value": 99.5 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Avg Response Time (s)" },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.5 },
                    { "color": "red", "value": 1.0 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Availability (%)" },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "color": "red", "value": 99 },
                    { "color": "yellow", "value": 99.5 },
                    { "color": "green", "value": 99.9 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 46 }
    }
  ]
}
