# Kong API Gateway Environment Configuration
# Copy this file to .env and update the values

# Public IP address of your server
PUBLIC_IP=your_public_ip_here

# Private IP of the EC2 instance running AI models
AI_MODEL_IP=172.31.31.208

# MongoDB connection string for API key sync
MONGODB_URI=mongodb://dhruva-platform-app-db:27017

# Kong Admin API URL
KONG_ADMIN_URL=http://kong:8001

# API key sync interval in seconds
SYNC_INTERVAL=30

# SSL Configuration
SSL_VERIFY=true
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Domain name (for Let's Encrypt)
DOMAIN=yourdomain.com

# Email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Rate Limiting Configuration
ASR_RATE_LIMIT=100
TTS_RATE_LIMIT=50
TRANSLATION_RATE_LIMIT=200
BACKEND_RATE_LIMIT=1000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security Configuration
CORS_ORIGINS=*
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_HEADERS=Accept,Accept-Version,Content-Length,Content-MD5,Content-Type,Date,X-Auth-Token,Authorization,X-API-Key

# Timeout Configuration (in milliseconds)
CONNECT_TIMEOUT=60000
READ_TIMEOUT=60000
WRITE_TIMEOUT=60000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
